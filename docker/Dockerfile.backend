# syntax=docker/dockerfile:1
FROM golang:1.23-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/provenancex ./cmd/provenancex

FROM alpine:3.20 AS runner

WORKDIR /app
RUN apk add --no-cache ca-certificates git

COPY --from=builder /bin/provenancex /usr/local/bin/provenancex

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/provenancex"]
CMD ["version"]
